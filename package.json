{
  "name": "edge-pdf-lite",
  "version": "1.1.1",
  "type": "module",
  "description": "轻量 PDF 阅读 + 批注编辑器（面向低配 Windows）",
  "license": "MIT",
  "keywords": ["pdf", "reader", "annotation", "tauri", "vue", "pdfjs"],
  "author": "Huaji-cmd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huaji-cmd/edge-pdf-lite.git"
  },
  "homepage": "https://github.com/Huaji-cmd/edge-pdf-lite#readme",
  "bugs": "https://github.com/Huaji-cmd/edge-pdf-lite/issues",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "testdata": "npm run testdata:local && node scripts/make-real-sample.mjs",
    "testdata:local": "node scripts/make-testdata.mjs && node scripts/make-annot-fixture.mjs && node scripts/make-scan-sample.mjs && node scripts/make-highlight-variants.mjs",
    "testdata:real": "node scripts/make-real-sample.mjs",
    "testdata:annot": "node scripts/make-annot-fixture.mjs",
    "testdata:scan": "node scripts/make-scan-sample.mjs",
    "dev": "vite",
    "dev:host": "vite --host",
    "icons": "node scripts/make-icons.mjs",
    "prebuild": "npm run icons",
    "build-only": "vite build",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "serve:dist": "node scripts/serve-dist.mjs",
    "app": "node scripts/app.mjs",
    "test:csp": "node scripts/test-csp.mjs",
    "test:viewer": "node scripts/test-viewer.mjs",
    "test:annot": "node scripts/test-annot.mjs",
    "test:writer": "node scripts/test-writer.mjs",
    "test:interact": "node scripts/test-interact.mjs",
    "test:touch": "node scripts/test-touch.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:preview": "node scripts/test-preview.mjs",
    "test": "node scripts/test-csp.mjs && node scripts/test-viewer.mjs && node scripts/test-annot.mjs && node scripts/test-writer.mjs && node scripts/test-interact.mjs && node scripts/test-touch.mjs && node scripts/test-pwa.mjs && node scripts/test-preview.mjs",
    "variants": "node scripts/make-highlight-variants.mjs",
    "edge:shot": "node scripts/edge-pdf-shot.mjs",
    "tauri": "node scripts/tauri.mjs",
    "exe": "node scripts/tauri.mjs build --no-bundle",
    "test:exe": "node scripts/test-exe.mjs",
    "test:exe:heal": "node scripts/test-exe-heal.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
